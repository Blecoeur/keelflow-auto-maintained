{
    "enabled": true,
    "allow_bash": true,
    "blocked_paths": [
        ".github/**",
        "**/.npmrc",
        "**/.pnpmfile.*",
        "**/tests/**",
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.spec.*"
    ],
    "max_attempts": 2,
    "max_turns": 6,
    "max_tokens": 10000,
    "timeout_seconds": 900,
    "budget_cents": 300
}
